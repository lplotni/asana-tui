" ┏ Keys ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓ "
"┏┃ Inbox and task                                  Tab i        go to Inbox  · Asana              ┃┐"
"┃┃ j / k        down / up  · Asana                 o            open in browser                   ┃│"
"┃┃ gg           top                                f            unread only / all                 ┃│"
"┃┃ G            bottom, or line N with a count     P            open a project's board            ┃│"
"┃┃ Ctrl-d       half page down                     b            open the task's board             ┃│"
"┃┃ Ctrl-u       half page up                       Tab q        new task on the board  · Asana    ┃│"
"┃┃ h, Ctrl-w h  focus left pane                    d            complete / reopen                 ┃│"
"┃┃ l, Ctrl-w l  focus right pane                   Tab a        assign  · Asana                   ┃│"
"┃┃ Enter        open / focus detail                R            refresh                           ┃│"
"┃┃ Esc          back  · Asana                      v            board lanes / columns             ┃│"
"┃┃ /            search                             :            command line                      ┃│"
"┃┃ S            search tasks in the workspace      q            back; quit from the Inbox list    ┃│"
"┃┃ n / N        next match / previous match        Ctrl-c       quit from anywhere                ┃│"
"┃┃ V            visual line mode                   ?            help                              ┃│"
"┃┃ e            mark read (stays listed)  · Asana                                                 ┃│"
"┃┃ u            mark unread  · Asana               Text fields and pickers                        ┃│"
"┃┃ x            toggle read                        Enter        confirm                           ┃│"
"┃┃ c, Tab c     comment  · Asana                   Esc, Ctrl-c  cancel                            ┃│"
"┃┃ Tab e        edit description                   Backspace    delete character                  ┃│"
"┃┃ p, Tab p     add to project  · Asana            Ctrl-n, Down next item                         ┃│"
"┗┃ m            move to another section            Ctrl-p, Up   previous item                     ┃┘"
" ┗ any key closes ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ "
" any key close                                                                                      "
