" ┏ Keys ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓ "
"┏┃ Inbox and task                                  Tab i        go to Inbox  · Asana              ┃┐"
"┃┃ j / k        down / up  · Asana                 o            open in browser                   ┃│"
"┃┃ gg           top                                f            unread only / all                 ┃│"
"┃┃ G            bottom, or line N with a count     P            open a project's board            ┃│"
"┃┃ Ctrl-d       half page down                     b            open the task's board             ┃│"
"┃┃ Ctrl-u       half page up                       Tab q        new task on the board  · Asana    ┃│"
"┃┃ h, Ctrl-w h  focus left pane                    d            complete / reopen                 ┃│"
"┃┃ l, Ctrl-w l  focus right pane                   Tab a        assign  · Asana                   ┃│"
"┃┃ Enter        open / focus detail                R            refresh                           ┃│"
"┃┃ Esc          back  · Asana                      :            command line                      ┃│"
"┃┃ /            search                             q            back; quit from the Inbox list    ┃│"
"┃┃ S            search tasks in the workspace      Ctrl-c       quit from anywhere                ┃│"
"┃┃ n / N        next match / previous match        ?            help                              ┃│"
"┃┃ V            visual line mode                                                                  ┃│"
"┃┃ e            mark read (stays listed)  · Asana  Text fields and pickers                        ┃│"
"┃┃ u            mark unread  · Asana               Enter        confirm                           ┃│"
"┃┃ x            toggle read                        Esc, Ctrl-c  cancel                            ┃│"
"┃┃ c, Tab c     comment  · Asana                   Backspace    delete character                  ┃│"
"┃┃ Tab e        edit description                   Ctrl-n, Down next item                         ┃│"
"┃┃ p, Tab p     add to project  · Asana            Ctrl-p, Up   previous item                     ┃│"
"┗┃ m            move to another section                                                           ┃┘"
" ┗ any key closes ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ "
" any key close                                                                                      "
