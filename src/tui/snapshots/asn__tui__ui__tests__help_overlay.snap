" ┏ Keys ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓ "
"┏┃ Inbox and task                                  p, Tab p     add to project  · Asana           ┃┐"
"┃┃ j            down  · Asana                      m            move to another section           ┃│"
"┃┃ k            up  · Asana                        Tab i        go to Inbox  · Asana              ┃│"
"┃┃ gg           top                                o            open in browser                   ┃│"
"┃┃ G            bottom, or line N with a count     f            unread only / all                 ┃│"
"┃┃ Ctrl-d       half page down                     P            open a project's board            ┃│"
"┃┃ Ctrl-u       half page up                       b            open the task's board             ┃│"
"┃┃ h, Ctrl-w h  focus left pane                    Tab q        new task on the board  · Asana    ┃│"
"┃┃ l, Ctrl-w l  focus right pane                   R            refresh                           ┃│"
"┃┃ Enter        open / focus detail                :            command line                      ┃│"
"┃┃ Esc          back  · Asana                      q            back; quit from the Inbox list    ┃│"
"┃┃ /            search                             Ctrl-c       quit from anywhere                ┃│"
"┃┃ S            search tasks in the workspace      ?            help                              ┃│"
"┃┃ n            next match                                                                        ┃│"
"┃┃ N            previous match                     Text fields and pickers                        ┃│"
"┃┃ V            visual line mode                   Enter        confirm                           ┃│"
"┃┃ e            mark read (stays listed)  · Asana  Esc, Ctrl-c  cancel                            ┃│"
"┃┃ u            mark unread  · Asana               Backspace    delete character                  ┃│"
"┃┃ x            toggle read                        Ctrl-n, Down next item                         ┃│"
"┃┃ c, Tab c     comment  · Asana                   Ctrl-p, Up   previous item                     ┃│"
"┗┃ Tab e        edit description                                                                  ┃┘"
" ┗ any key closes ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ "
" any key close                                                                                      "
