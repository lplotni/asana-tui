" asn  Inbox · 5 unread                                                                      [f] all "
"┏┏ Keys ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓┐"
"┃┃ Inbox and task                                  Tab e        edit description                  ┃│"
"┃┃ j            down  · Asana                      p, Tab p     add to project  · Asana           ┃│"
"┃┃ k            up  · Asana                        m            move to another section           ┃│"
"┃┃ gg           top                                Tab i        go to Inbox  · Asana              ┃│"
"┃┃ G            bottom, or line N with a count     o            open in browser                   ┃│"
"┃┃ Ctrl-d       half page down                     f            unread only / all                 ┃│"
"┃┃ Ctrl-u       half page up                       P            open a project's board            ┃│"
"┃┃ h, Ctrl-w h  focus left pane                    R            refresh                           ┃│"
"┃┃ l, Ctrl-w l  focus right pane                   :            command line                      ┃│"
"┃┃ Enter        open / focus detail                q            back; quit from the Inbox list    ┃│"
"┃┃ Esc          back  · Asana                      Ctrl-c       quit from anywhere                ┃│"
"┃┃ /            search                             ?            help                              ┃│"
"┃┃ S            search tasks in the workspace                                                     ┃│"
"┃┃ n            next match                         Text fields and pickers                        ┃│"
"┃┃ N            previous match                     Enter        confirm                           ┃│"
"┃┃ V            visual line mode                   Esc, Ctrl-c  cancel                            ┃│"
"┃┃ e            mark read (stays listed)  · Asana  Backspace    delete character                  ┃│"
"┃┃ u            mark unread  · Asana               Ctrl-n, Down next item                         ┃│"
"┃┃ x            toggle read                        Ctrl-p, Up   previous item                     ┃│"
"┗┃ c, Tab c     comment  · Asana                                                                  ┃┘"
